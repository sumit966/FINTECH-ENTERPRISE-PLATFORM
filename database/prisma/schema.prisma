// ============================================================================
// NEXUS ENTERPRISE PLATFORM - Prisma Schema
// FINTECH IT SOLUTIONS - Founder & CEO: Sumit Raj
// PostgreSQL 16 - Normalized, production-quality
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. IDENTITY / AUTH / RBAC
// ============================================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  phone          String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  employeeId     String?   @unique
  employee       Employee? @relation(fields: [employeeId], references: [id])

  userRoles      UserRole[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  sessions       Session[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  level       Int        @default(0)
  isSystem    Boolean    @default(true)

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Permission {
  id          String            @id @default(cuid())
  code        String            @unique
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  createdAt   DateTime          @default(now())
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedBy   String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// 2. LOCATIONS / DEPARTMENTS / TEAMS
// ============================================================================

model Location {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String
  state     String
  country   String   @default("India")
  address   String?
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)

  employees Employee[]
  projects  Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  description String?
  costCenter  String?
  isActive    Boolean  @default(true)

  teams       Team[]
  employees   Employee[]
  headOf      Employee[] @relation("DepartmentHead")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  departmentId String
  leadId       String?
  isActive     Boolean    @default(true)

  department   Department @relation(fields: [departmentId], references: [id])
  lead         Employee?  @relation("TeamLead", fields: [leadId], references: [id])
  members      Employee[] @relation("TeamMembers")
  projects     Project[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

// ============================================================================
// 3. EMPLOYEES
// ============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
  RETIRED
}

model Employee {
  id               String            @id @default(cuid())
  employeeCode     String            @unique
  fullName         String
  gender           Gender
  email            String            @unique
  personalEmail    String?
  phone            String
  dateOfBirth      DateTime
  joiningDate      DateTime
  employmentType   EmploymentType
  employmentStatus EmploymentStatus  @default(ACTIVE)
  experienceYears  Int               @default(0)
  salaryGrade      String
  basicSalary      Decimal           @db.Decimal(14, 2)
  hra              Decimal           @db.Decimal(14, 2)
  allowances       Decimal           @db.Decimal(14, 2)
  bonus            Decimal           @db.Decimal(14, 2) @default(0)
  grossSalary      Decimal           @db.Decimal(14, 2)
  deductions       Decimal           @db.Decimal(14, 2) @default(0)
  netSalary        Decimal           @db.Decimal(14, 2)
  leaveBalance     Int               @default(24)
  performanceScore Decimal?          @db.Decimal(5, 2)
  costCenter       String?

  locationId       String
  departmentId     String
  teamId           String?
  managerId        String?
  teamLeadId       String?

  location         Location          @relation(fields: [locationId], references: [id])
  department       Department        @relation(fields: [departmentId], references: [id])
  team             Team?             @relation("TeamMembers", fields: [teamId], references: [id])
  manager          Employee?         @relation("ManagerReports", fields: [managerId], references: [id])
  reports          Employee[]        @relation("ManagerReports")
  teamLead         Employee?         @relation("TeamLeadRef", fields: [teamLeadId], references: [id])
  teamLeadOf       Employee[]        @relation("TeamLeadRef")
  ledTeams         Team[]            @relation("TeamLead")
  headedDepartments Department[]     @relation("DepartmentHead")

  user             User?
  attendances      Attendance[]
  leaves           Leave[]
  leaveBalances    LeaveBalance[]
  payrolls         Payroll[]
  projectMembers   ProjectMember[]
  skills           EmployeeSkill[]
  certifications   EmployeeCertification[]
  assets           Asset[]
  documents        Document[]
  interviews       Interview[]       @relation("InterviewerRef")
  candidates       Candidate[]       @relation("CandidateRef")
  notifications    Notification[]
  onboarding       OnboardingRecord?
  paymentsApproved Payroll[]        @relation("PayrollApprover")
  managedProjects  Project[]        @relation("ProjectManager")
  managedClients   Client[]         @relation("ClientAccountManager")

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([locationId])
  @@index([departmentId])
  @@index([teamId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([salaryGrade])
}

// ============================================================================
// 4. ATTENDANCE / LEAVE
// ============================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  HALF_DAY
  WFH
  HOLIDAY
  LEAVE
  OVERTIME
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
  INTEGRATION
}

model Attendance {
  id               String           @id @default(cuid())
  employeeId       String
  date             DateTime
  checkIn          DateTime?
  checkOut         DateTime?
  workingHours     Decimal?         @db.Decimal(5, 2)
  overtimeHours    Decimal?         @db.Decimal(5, 2)
  status           AttendanceStatus
  workMode         String
  source           AttendanceSource @default(MANUAL)
  notes            String?

  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  OPTIONAL_HOLIDAY
  UNPAID
  WFH
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id              String      @id @default(cuid())
  employeeId      String
  leaveType       LeaveType
  startDate       DateTime
  endDate         DateTime
  days            Int
  reason          String?
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model LeaveBalance {
  id           String   @id @default(cuid())
  employeeId   String
  leaveType    LeaveType
  year         Int
  opening      Int      @default(0)
  credited     Int      @default(0)
  used         Int      @default(0)
  balance      Int      @default(0)

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, leaveType, year])
}

// ============================================================================
// 5. PAYROLL
// ============================================================================

enum PayrollStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payroll {
  id             String         @id @default(cuid())
  payrollCode    String         @unique
  employeeId     String
  month          Int
  year           Int
  basicSalary    Decimal        @db.Decimal(14, 2)
  hra            Decimal        @db.Decimal(14, 2)
  allowances     Decimal        @db.Decimal(14, 2)
  bonus          Decimal        @db.Decimal(14, 2) @default(0)
  grossSalary    Decimal        @db.Decimal(14, 2)
  tax            Decimal        @db.Decimal(14, 2)
  deductions     Decimal        @db.Decimal(14, 2)
  netSalary      Decimal        @db.Decimal(14, 2)
  status         PayrollStatus  @default(PENDING)
  paymentDate    DateTime?
  paymentMethod  String?
  department     String
  location       String
  approvedById   String?

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy     Employee?      @relation("PayrollApprover", fields: [approvedById], references: [id])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@index([status])
}

// ============================================================================
// 6. CLIENTS / CRM
// ============================================================================

enum ClientStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  CHURNED
}

model Client {
  id               String         @id @default(cuid())
  clientCode       String         @unique
  companyName      String
  country          String
  industry         String
  accountManagerId String?
  contractValue    Decimal        @db.Decimal(16, 2)
  revenue          Decimal        @db.Decimal(16, 2) @default(0)
  billingTerms     String
  slaTier          String
  healthScore      Decimal?       @db.Decimal(5, 2)
  status           ClientStatus   @default(ACTIVE)

  accountManager Employee?      @relation("ClientAccountManager", fields: [accountManagerId], references: [id])
  contacts       ClientContact[]
  projects       Project[]
  invoices       Invoice[]
  contracts      Contract[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([country])
  @@index([industry])
  @@index([status])
}

model ClientContact {
  id         String   @id @default(cuid())
  clientId   String
  fullName   String
  title      String
  email      String
  phone      String?
  isPrimary  Boolean  @default(false)

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
}

model Contract {
  id            String   @id @default(cuid())
  contractCode  String   @unique
  clientId      String
  title         String
  startDate     DateTime
  endDate       DateTime
  value         Decimal  @db.Decimal(16, 2)
  currency      String   @default("USD")
  terms         String?
  status        String   @default("ACTIVE")

  client        Client   @relation(fields: [clientId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

// ============================================================================
// 7. PROJECTS / DELIVERY
// ============================================================================

enum ProjectStatus {
  PLANNING
  PENDING
  ACTIVE
  ON_HOLD
  QA
  DEPLOYMENT
  DELIVERED
  MAINTENANCE
  CLOSED
}

model Project {
  id                String         @id @default(cuid())
  projectCode       String         @unique
  name              String
  clientId          String
  industry          String
  country           String
  projectManagerId  String?
  teamId            String?
  locationId        String?
  startDate         DateTime
  expectedEndDate   DateTime
  actualEndDate     DateTime?
  status            ProjectStatus  @default(PLANNING)
  progressPercent   Int            @default(0)
  budget            Decimal        @db.Decimal(16, 2)
  revenue           Decimal        @db.Decimal(16, 2) @default(0)
  cost              Decimal        @db.Decimal(16, 2) @default(0)
  profit            Decimal        @db.Decimal(16, 2) @default(0)
  techFrontend      String[]
  techBackend       String[]
  techDatabase      String[]
  techCloud         String[]
  techAI            String[]
  apiStyle          String?
  integrations      String[]
  repository        String?
  environment       String         @default("PRODUCTION")
  healthScore       Decimal?       @db.Decimal(5, 2)
  riskScore         Decimal?       @db.Decimal(5, 2)
  securityStatus    String         @default("PASS")
  qaStatus          String         @default("PASS")

  client            Client         @relation(fields: [clientId], references: [id])
  projectManager    Employee?      @relation("ProjectManager", fields: [projectManagerId], references: [id])
  team              Team?          @relation(fields: [teamId], references: [id])
  location          Location?      @relation(fields: [locationId], references: [id])

  members           ProjectMember[]
  tasks             ProjectTask[]
  milestones        ProjectMilestone[]
  risks             ProjectRisk[]
  invoices          Invoice[]
  repositories      Repository[]
  deployments       Deployment[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([projectManagerId])
  @@index([teamId])
}

model ProjectMember {
  id          String    @id @default(cuid())
  projectId   String
  employeeId  String
  role        String
  allocation  Int       @default(100)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

model ProjectTask {
  id           String      @id @default(cuid())
  taskCode     String      @unique
  projectId    String
  title        String
  description  String?
  assigneeId   String?
  status       TaskStatus  @default(TODO)
  priority     String      @default("MEDIUM")
  estimateHrs  Decimal?    @db.Decimal(6, 2)
  spentHrs     Decimal?    @db.Decimal(6, 2)
  dueDate      DateTime?
  completedAt  DateTime?

  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([projectId])
  @@index([status])
}

model ProjectMilestone {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  dueDate      DateTime
  completedAt  DateTime?
  status       String    @default("PENDING")

  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
}

model ProjectRisk {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  severity    String
  probability Decimal?  @db.Decimal(5, 2)
  impact      Decimal?  @db.Decimal(5, 2)
  mitigation  String?
  status      String    @default("OPEN")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

// ============================================================================
// 8. FINANCE / ERP
// ============================================================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String         @id @default(cuid())
  invoiceNumber  String         @unique
  clientId       String
  projectId      String?
  issueDate      DateTime
  dueDate        DateTime
  paidDate       DateTime?
  subtotal       Decimal        @db.Decimal(16, 2)
  taxAmount      Decimal        @db.Decimal(16, 2)
  total          Decimal        @db.Decimal(16, 2)
  currency       String         @default("USD")
  status         InvoiceStatus  @default(DRAFT)
  paidAmount     Decimal        @db.Decimal(16, 2) @default(0)

  client         Client         @relation(fields: [clientId], references: [id])
  project        Project?       @relation(fields: [projectId], references: [id])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id            String    @id @default(cuid())
  expenseCode   String    @unique
  category      String
  description   String
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("INR")
  incurredAt    DateTime
  submittedById String
  approvedById  String?
  status        String    @default("PENDING")
  receiptUrl    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@index([status])
}

// ============================================================================
// 9. VENDORS / PROCUREMENT
// ============================================================================

model Vendor {
  id            String   @id @default(cuid())
  vendorCode    String   @unique
  name          String
  category      String
  contactName   String
  email         String
  phone         String
  country       String
  gstNumber     String?
  status        String   @default("ACTIVE")
  rating        Decimal? @db.Decimal(3, 2)

  purchaseOrders PurchaseOrder[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  poNumber     String    @unique
  vendorId     String
  title        String
  description  String?
  amount       Decimal   @db.Decimal(16, 2)
  currency     String    @default("INR")
  issuedAt     DateTime
  deliveredAt  DateTime?
  status       String    @default("OPEN")
  approvedById String?

  vendor       Vendor    @relation(fields: [vendorId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vendorId])
  @@index([status])
}

// ============================================================================
// 10. ASSETS / LICENSES
// ============================================================================

model Asset {
  id            String    @id @default(cuid())
  assetCode     String    @unique
  type          String
  brand         String
  model         String
  serialNumber  String    @unique
  assignedToId  String?
  locationId    String?
  purchasedAt   DateTime
  warrantyUntil DateTime?
  status        String    @default("IN_USE")
  cost          Decimal   @db.Decimal(12, 2)

  assignedTo    Employee? @relation(fields: [assignedToId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([assignedToId])
  @@index([status])
}

model License {
  id             String    @id @default(cuid())
  licenseCode    String    @unique
  product        String
  vendorId       String?
  seats          Int
  usedSeats      Int       @default(0)
  costPerSeat    Decimal   @db.Decimal(12, 2)
  currency       String    @default("USD")
  purchasedAt    DateTime
  renewalAt      DateTime
  status         String    @default("ACTIVE")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([renewalAt])
}

// ============================================================================
// 11. RECRUITMENT / ATS
// ============================================================================

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

model JobOpening {
  id             String         @id @default(cuid())
  jobCode        String         @unique
  title          String
  departmentId   String
  locationId     String
  employmentType EmploymentType
  level          String
  minExperience  Int
  maxExperience  Int
  description    String
  requiredSkills String[]
  openings       Int            @default(1)
  status         JobStatus      @default(OPEN)
  postedAt       DateTime       @default(now())
  closedAt       DateTime?
  recruiterId    String?

  candidates     Candidate[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([departmentId])
}

enum CandidateStage {
  APPLIED
  SCREENING
  ASSESSMENT
  TECHNICAL_INTERVIEW
  MANAGER_INTERVIEW
  HR_INTERVIEW
  SELECTED
  OFFER
  JOINED
  REJECTED
}

model Candidate {
  id             String         @id @default(cuid())
  candidateCode  String         @unique
  jobId          String
  fullName       String
  email          String
  phone          String
  resumeUrl      String?
  currentCompany String?
  currentCtc     Decimal?       @db.Decimal(14, 2)
  expectedCtc    Decimal?       @db.Decimal(14, 2)
  noticePeriod   Int?
  source         String
  stage          CandidateStage @default(APPLIED)
  score          Decimal?       @db.Decimal(5, 2)
  appliedAt      DateTime       @default(now())
  employeeId     String?

  job            JobOpening     @relation(fields: [jobId], references: [id])
  employee       Employee?      @relation("CandidateRef", fields: [employeeId], references: [id])
  interviews     Interview[]
  examAttempts   ExamAttempt[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([jobId])
  @@index([stage])
}

enum InterviewMode {
  IN_PERSON
  VIDEO
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Interview {
  id             String          @id @default(cuid())
  candidateId    String
  round          String
  scheduledAt    DateTime
  durationMins   Int             @default(45)
  mode           InterviewMode   @default(VIDEO)
  interviewerId  String?
  status         InterviewStatus @default(SCHEDULED)
  feedback       String?
  score          Decimal?        @db.Decimal(5, 2)
  recommendation String?

  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer    Employee?       @relation("InterviewerRef", fields: [interviewerId], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([candidateId])
  @@index([interviewerId])
  @@index([scheduledAt])
}

// ============================================================================
// 12. EXAMS / ASSESSMENTS
// ============================================================================

enum QuestionType {
  MCQ
  CODING
  APTITUDE
  LOGICAL
  SQL
  DESCRIPTIVE
}

model Question {
  id            String       @id @default(cuid())
  questionCode  String       @unique
  type          QuestionType
  category      String
  difficulty    String       @default("MEDIUM")
  prompt        String
  options       String[]
  correctAnswer String
  explanation   String?
  points        Int          @default(1)
  timeLimitSec  Int          @default(60)
  starterCode   String?
  testCases     Json?

  assessmentQuestions AssessmentQuestion[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category])
  @@index([difficulty])
}

model Assessment {
  id             String    @id @default(cuid())
  assessmentCode String    @unique
  title          String
  description    String?
  durationMins   Int       @default(60)
  totalPoints    Int       @default(0)
  category       String
  isActive       Boolean   @default(true)

  questions      AssessmentQuestion[]
  attempts       ExamAttempt[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AssessmentQuestion {
  id            String     @id @default(cuid())
  assessmentId  String
  questionId    String
  order         Int

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

model ExamAttempt {
  id           String        @id @default(cuid())
  attemptCode  String        @unique
  assessmentId String
  candidateId  String?
  employeeId   String?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  status       AttemptStatus @default(IN_PROGRESS)
  score        Decimal?      @db.Decimal(6, 2)
  totalPoints  Int?
  language     String?
  code         String?
  output       String?
  errorOutput  String?
  testResult   Json?

  assessment   Assessment    @relation(fields: [assessmentId], references: [id])
  candidate    Candidate?    @relation(fields: [candidateId], references: [id])

  @@index([assessmentId])
  @@index([candidateId])
  @@index([employeeId])
}

// ============================================================================
// 13. SKILLS / CERTIFICATIONS
// ============================================================================

model Skill {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String
  description  String?

  employeeSkills EmployeeSkill[]

  createdAt    DateTime @default(now())
}

model EmployeeSkill {
  id           String    @id @default(cuid())
  employeeId   String
  skillId      String
  proficiency  Int       @default(1)
  yearsUsed    Decimal?  @db.Decimal(4, 1)

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill        Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
}

model Certification {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  issuer       String
  validityMons Int?

  employeeCertifications EmployeeCertification[]

  createdAt    DateTime @default(now())
}

model EmployeeCertification {
  id              String        @id @default(cuid())
  employeeId      String
  certificationId String
  issuedAt        DateTime
  expiresAt       DateTime?
  credentialId    String?
  status          String        @default("ACTIVE")

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, certificationId])
  @@index([expiresAt])
}

// ============================================================================
// 14. ENGINEERING / DEVOPS
// ============================================================================

model Repository {
  id            String   @id @default(cuid())
  repoCode      String   @unique
  name          String
  projectId     String?
  provider      String   @default("GITHUB")
  url           String
  defaultBranch String   @default("main")
  language      String
  isPrivate     Boolean  @default(true)

  project       Project? @relation(fields: [projectId], references: [id])
  pullRequests  PullRequest[]
  builds        Build[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model PullRequest {
  id           String     @id @default(cuid())
  prNumber     Int
  repositoryId String
  title        String
  authorId     String?
  sourceBranch String
  targetBranch String
  status       String     @default("OPEN")
  additions    Int        @default(0)
  deletions    Int        @default(0)
  reviewedBy   String[]
  openedAt     DateTime   @default(now())
  mergedAt     DateTime?

  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, prNumber])
  @@index([status])
}

model Build {
  id           String     @id @default(cuid())
  buildCode    String     @unique
  repositoryId String
  branch       String
  commitSha    String
  status       String     @default("SUCCESS")
  durationSec  Int
  triggeredBy  String?
  startedAt    DateTime   @default(now())
  completedAt  DateTime?

  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  testRuns     TestRun[]

  @@index([repositoryId])
  @@index([status])
}

model TestRun {
  id          String   @id @default(cuid())
  buildId     String
  totalTests  Int
  passed      Int
  failed      Int
  skipped     Int      @default(0)
  coveragePct Decimal? @db.Decimal(5, 2)
  durationSec Int

  build       Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@index([buildId])
}

model Deployment {
  id             String    @id @default(cuid())
  deploymentCode String    @unique
  projectId      String?
  environment    String
  version        String
  status         String
  deployedAt     DateTime  @default(now())
  deployedBy     String?
  commitSha      String?
  notes          String?

  project        Project?  @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([environment])
  @@index([deployedAt])
}

// ============================================================================
// 15. SECURITY / AUDIT
// ============================================================================

model SecurityEvent {
  id            String   @id @default(cuid())
  eventCode     String   @unique
  category      String
  severity      String
  title         String
  description   String?
  source        String?
  affectedAsset String?
  status        String   @default("OPEN")
  resolvedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([severity])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// 16. DOCUMENTS / KNOWLEDGE
// ============================================================================

model Document {
  id           String   @id @default(cuid())
  documentCode String   @unique
  title        String
  category     String
  mimeType     String
  sizeBytes    Int
  storageUrl   String
  ownerId      String?
  accessLevel  String   @default("INTERNAL")
  tags         String[]
  version      Int      @default(1)
  parentId     String?

  owner        Employee? @relation(fields: [ownerId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([ownerId])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  body      String
  tags      String[]
  authorId  String?
  published Boolean  @default(true)
  viewCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ============================================================================
// 17. NOTIFICATIONS / CALENDAR / AUTOMATION / KPIs
// ============================================================================

model Notification {
  id         String    @id @default(cuid())
  userId     String
  employeeId String?
  type       String
  title      String
  body       String
  link       String?
  isRead     Boolean   @default(false)
  readAt     DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  ownerId     String?
  projectId   String?
  clientId    String?
  location    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([startAt])
}

model AutomationRule {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  trigger      String
  triggerExpr  String?
  action       String
  actionParams Json?
  isEnabled    Boolean  @default(true)
  lastRunAt    DateTime?
  lastStatus   String?

  runs         AutomationRun[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AutomationRun {
  id           String         @id @default(cuid())
  ruleId       String
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  status       String         @default("SUCCESS")
  output       Json?
  errorMessage String?

  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status])
}

model Kpi {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  category     String
  unit         String
  formula      String
  targetValue  Decimal? @db.Decimal(16, 2)
  currentValue Decimal? @db.Decimal(16, 2)
  trend        String?
  updatedAt    DateTime @updatedAt

  snapshots    KpiSnapshot[]

  @@index([category])
}

model KpiSnapshot {
  id         String   @id @default(cuid())
  kpiId      String
  value      Decimal  @db.Decimal(16, 2)
  capturedAt DateTime @default(now())

  kpi        Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
  @@index([capturedAt])
}

// ============================================================================
// 18. ONBOARDING
// ============================================================================

enum OnboardingStage {
  OFFER_ACCEPTED
  PERSONAL_DETAILS
  DOCUMENTS
  DEPT_ASSIGNMENT
  MANAGER_ASSIGNMENT
  ACCOUNT_SETUP
  ASSET_ASSIGNMENT
  POLICY_ACK
  ORIENTATION
  COMPLETE
}

enum OnboardingStatus {
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model OnboardingRecord {
  id            String           @id @default(cuid())
  employeeId    String           @unique
  currentStage  OnboardingStage  @default(OFFER_ACCEPTED)
  status        OnboardingStatus @default(IN_PROGRESS)
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  notes         String?

  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks         OnboardingTask[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
}

model OnboardingTask {
  id           String           @id @default(cuid())
  recordId     String
  stage        OnboardingStage
  title        String
  description  String?
  assignedTo   String?
  isComplete   Boolean          @default(false)
  completedAt  DateTime?
  completedBy  String?

  record       OnboardingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([recordId])
  @@index([stage])
  @@index([isComplete])
}
// ============================================================================
// 19. FUNDING INTELLIGENCE
// ============================================================================

enum FundingType {
  EQUITY
  GRANT
  DEBT
  REVENUE_SHARE
  OTHER
}

enum FundingStatus {
  RECORDED
  VERIFIED
  APPROVED
  DISBURSED
  RECEIVED
  REJECTED
}

model FundingRecord {
  id                    String         @id @default(cuid())
  fundingCode           String         @unique
  source                String
  sourceType            String
  country               String
  amount                Decimal        @db.Decimal(18, 2)
  currency              String         @default("INR")
  fundingType           FundingType
  status                FundingStatus  @default(RECORDED)
  recordedAt            DateTime       @default(now())
  verifiedAt            DateTime?
  approvedAt            DateTime?
  notes                 String?
  supportingDocumentUrl String?

  disbursements FundingDisbursement[]
  documents     FundingDocument[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

model FundingDisbursement {
  id           String        @id @default(cuid())
  fundingId    String
  amount       Decimal       @db.Decimal(18, 2)
  expectedDate DateTime
  receivedAt   DateTime?
  status       String        @default("PENDING")
  reference    String?
  notes        String?

  funding      FundingRecord @relation(fields: [fundingId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([fundingId])
}

model FundingDocument {
  id         String        @id @default(cuid())
  fundingId  String
  title      String
  category   String
  url        String
  verifiedBy String?
  verifiedAt DateTime?

  funding    FundingRecord @relation(fields: [fundingId], references: [id], onDelete: Cascade)

  createdAt  DateTime      @default(now())

  @@index([fundingId])
}


// ============================================================================
// 20. AUTOMATION RUN LOG + BIOMETRIC DEVICE
// ============================================================================

model AutomationRunLog {
  id          String   @id @default(cuid())
  runId       String?
  ruleCode    String
  trigger     String
  workflow    String?
  status      String   @default("PENDING")
  triggeredBy String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  finishedAt  DateTime?
  message     String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([workflow])
  @@index([status])
  @@index([ruleCode])
}

model BiometricDevice {
  id              String   @id @default(cuid())
  deviceCode      String   @unique
  name            String
  vendor          String?
  model           String?
  locationCode    String?
  ipAddress       String?
  integrationType String   @default("MANUAL")
  status          String   @default("INTEGRATION_REQUIRED")
  lastSeenAt      DateTime?
  lastSyncAt      DateTime?
  firmwareVersion String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([locationCode])
}
